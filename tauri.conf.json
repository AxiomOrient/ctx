{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.ctx.app",
  "productName": "ctx-ui",
  "version": "0.1.0",
  "build": {
    "beforeBuildCommand": "npm run build --prefix apps/ui",
    "frontendDist": "apps/ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ 
      "label": "main",
      "title": "ctx", 
      "width": 1280, 
      "height": 840,
      "devtools": true
    }],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "icon": ["icons/icon.png"]
  }
}
