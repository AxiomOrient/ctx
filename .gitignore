# =============================================================================
# Ctx Project .gitignore
# Rust CLI 도구 및 라이브러리 프로젝트용 포괄적인 ignore 설정
# =============================================================================

# -----------------------------------------------------------------------------
# Rust 관련 파일들
# -----------------------------------------------------------------------------

# Cargo 빌드 결과물
/target/
**/target/

# Cargo.lock (라이브러리 프로젝트의 경우 일반적으로 ignore)
# 바이너리 프로젝트라면 주석 해제하여 포함시킬 수 있음
# Cargo.lock

# Cargo 백업 파일
Cargo.lock.bak

# 러스트 컴파일러 생성 파일
*.pdb
*.exe
*.dll
*.so
*.dylib

# 러스트 프로파일링 결과
*.profraw
perf.data*

# 벤치마크 결과
criterion/

# -----------------------------------------------------------------------------
# IDE 및 에디터 관련 파일들
# -----------------------------------------------------------------------------

# Visual Studio Code
.vscode/
*.code-workspace

# IntelliJ IDEA / CLion / RustRover
.idea/
*.iml
*.ipr
*.iws

# Vim/Neovim
*.swp
*.swo
*~
.netrwhist
Session.vim
Sessionx.vim

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# Atom
.atom/

# -----------------------------------------------------------------------------
# 운영체제 관련 파일들
# -----------------------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.tmp
*.temp
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# 개발 도구 및 빌드 관련
# -----------------------------------------------------------------------------

# 로그 파일
*.log
logs/
log/

# 환경 변수 파일
.env
.env.local
.env.*.local

# 테스트 결과
test-results/
coverage/
*.lcov

# 임시 파일
tmp/
temp/
.tmp/
.temp/

# 백업 파일
*.bak
*.backup
*.old
*.orig

# 압축 파일
*.zip
*.tar.gz
*.rar
*.7z

# -----------------------------------------------------------------------------
# 프로젝트별 설정
# -----------------------------------------------------------------------------

# 설정 파일 (민감한 정보 포함 가능)
config/local.toml
config/development.toml
config/production.toml
.config/

# 데이터베이스 파일
*.db
*.sqlite
*.sqlite3

# 캐시 디렉토리
.cache/

# 빌드 아티팩트
dist/
build/
out/

# -----------------------------------------------------------------------------
# 문서 및 마크다운 파일들 (요청사항)
# -----------------------------------------------------------------------------

# 모든 마크다운 파일 무시
# *.md
# *.markdown
# *.mdown
# *.mkd
# *.mkdn

# 문서 디렉토리 (필요시 주석 해제)
# docs/
# documentation/

# -----------------------------------------------------------------------------
# 보안 관련 파일들
# -----------------------------------------------------------------------------

# 키 파일
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der

# 시크릿 파일
secrets/
.secrets/
*.secret

# 인증서
certificates/

# -----------------------------------------------------------------------------
# 네트워크 및 서비스 관련
# -----------------------------------------------------------------------------

# Docker
.dockerignore
docker-compose.override.yml

# Kubernetes
*.kubeconfig

# -----------------------------------------------------------------------------
# 기타 개발 관련 파일들
# -----------------------------------------------------------------------------

# 패키지 매니저 파일
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (혼합 프로젝트의 경우)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# 기타 언어 빌드 결과물
*.class
*.jar
*.war
*.ear
*.nar

# -----------------------------------------------------------------------------
# 프로젝트 특화 설정
# -----------------------------------------------------------------------------

# Ctx 특화 파일들
test_contexts/generated/
contexts/temp/
*.ctx.cache
ctxindex.db-shm
ctxindex.db-wal
log.md

# 테스트 생성 파일
test_output/
test_*.md
sample_*.md

# 성능 테스트 결과
benchmarks/
profiling/

# 실험적 기능 테스트
experiments/
playground/

# -----------------------------------------------------------------------------
# 주석 처리된 유용한 패턴들 (필요시 활성화)
# -----------------------------------------------------------------------------

# 특정 확장자만 허용하고 싶을 때
# *
# !*.rs
# !*.toml
# !*.yml
# !*.yaml
# !*.json

# 특정 디렉토리만 추적하고 싶을 때
# /*
# !/src/
# !/tests/
# !/examples/
# !Cargo.toml
# !README.md

# 대용량 파일 제외
# *.bin
# *.dat
# files_larger_than_100mb

# =============================================================================
# 끝
# =============================================================================
